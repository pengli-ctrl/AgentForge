# ===== AgentForge API Configuration =====

# Comma-separated list of valid API keys for authentication.
# Leave empty to disable API key auth (not recommended for production).
AGENTFORGE_API_KEYS=

# Enable debug mode (true/false).
# Debug mode skips API key authentication and includes error details in responses.
AGENTFORGE_DEBUG=false

# Rate limiting: token bucket capacity (max burst requests).
AGENTFORGE_RATE_LIMIT_CAPACITY=100

# Rate limiting: token refill rate (requests per second).
AGENTFORGE_RATE_LIMIT_RATE=10

# ===== Redis (State Store / Event Bus) =====

# Redis connection URL for context snapshot persistence and event bus.
REDIS_URL=redis://localhost:6379

# ===== MySQL (Task / Trace Persistence) =====

# MySQL server hostname.
MYSQL_HOST=localhost

# MySQL server port.
MYSQL_PORT=3306

# MySQL database name.
MYSQL_DATABASE=agentforge

# MySQL username.
MYSQL_USER=agentforge

# MySQL password.
MYSQL_PASSWORD=agentforge_secret

# ===== Kafka (Event Bus — production) =====

# Kafka bootstrap servers (comma-separated).
# Leave empty to use Redis Pub/Sub instead of Kafka.
KAFKA_BOOTSTRAP_SERVERS=

# ===== AgentForge Home =====

# Base directory for AgentForge data files (workflows, prompts, etc.).
AGENTFORGE_HOME=/app/agentforge
